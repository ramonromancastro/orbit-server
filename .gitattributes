# Normalizar todos los archivos de texto a LF en el repositorio
* text=auto eol=lf

# Scripts ejecutables y Python siempre en formato Unix
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binarios e imágenes no deben ser alterados
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
